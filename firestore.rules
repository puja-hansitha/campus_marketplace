rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - only owner can read/write their profile
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Products collection - authenticated users can create, only owner can update/delete
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.sellerId;
    }
    
    // Interests collection - authenticated users can manage their interests
    match /interests/{interestId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.buyerId || 
         request.auth.uid == resource.data.sellerId);
    }
    
    // Messages collection - participants can read/write
    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.senderId;
    }
    
    // Transactions collection - authenticated users can read, system creates
    match /transactions/{transactionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Notifications collection - recipient can read/update, authenticated users can create
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.token.email == resource.data.recipientId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.token.email == resource.data.recipientId;
      allow delete: if request.auth != null && request.auth.token.email == resource.data.recipientId;
    }
  }
}
