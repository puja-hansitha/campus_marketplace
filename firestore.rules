rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from an authenticated user?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is the requesting user the owner of the doc?
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Products ───────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.keys().hasAll(['sellerId','sellerName','imageURL','description','category','price','status','createdAt'])
        && request.resource.data.price is int
        && request.resource.data.price > 0;

      allow update: if isAuth()
        // Seller can update their own product
        && (resource.data.sellerId == request.auth.uid
        // OR: system updates (marking sold) — only status field allowed for non-owners
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));

      allow delete: if isOwner(resource.data.sellerId);
    }

    // ── Interests ──────────────────────────────────────────────────────────
    match /interests/{interestId} {
      allow read: if isAuth()
        && (resource.data.buyerId == request.auth.uid
         || resource.data.sellerId == request.auth.uid);

      allow create: if isAuth()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.keys().hasAll(['productId','buyerId','buyerName','sellerId','status','createdAt']);

      allow update: if isAuth()
        && (resource.data.sellerId == request.auth.uid
         || resource.data.buyerId == request.auth.uid);

      allow delete: if isAuth()
        && (resource.data.buyerId == request.auth.uid
         || resource.data.sellerId == request.auth.uid);
    }

    // ── Transactions ───────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if isAuth()
        && (resource.data.sellerId == request.auth.uid
         || resource.data.buyerId  == request.auth.uid);

      allow create: if isAuth()
        && request.resource.data.sellerId == request.auth.uid;

      allow update: if false;
      allow delete: if false;
    }

    // ── Messages ───────────────────────────────────────────────────────────
    match /messages/{msgId} {
      // conversationId = sorted([uid1, uid2, productId]).join('_')
      // Both parties can read/write
      allow read: if isAuth()
        && resource.data.conversationId.matches('.*' + request.auth.uid + '.*');

      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.conversationId.matches('.*' + request.auth.uid + '.*');

      // Only allow updating readBy field
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && resource.data.conversationId.matches('.*' + request.auth.uid + '.*');

      allow delete: if false;
    }

    // ── Notifications ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuth()
        && resource.data.recipientId == request.auth.uid;

      allow create: if isAuth();

      allow update: if isAuth()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

      allow delete: if isAuth()
        && resource.data.recipientId == request.auth.uid;
    }
  }
}
